{
  "manifest_version": 3,
  "name": "Asisten Belajar AI (Multi-Model & AI Agent)",
  "version": "1.5.0",
  "description": "Asisten belajar AI serbaguna: Auto-Pilot kuis, rekam suara Zoom & mic, ketik teks manual, kirim file (Groq, Gemini, DeepSeek, Whisper).",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "sidePanel",
    "clipboardWrite",
    "tabCapture",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://api.groq.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://openrouter.ai/*",
    "https://router.huggingface.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Asisten Belajar AI"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ]
}
